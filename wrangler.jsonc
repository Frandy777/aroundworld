{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aroundworld",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-06",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // One Durable Object per room. The room is written to its SQLite storage whenever it changes, so it
  // survives the object being evicted or restarted (a deploy); sockets hibernate, timers are alarms.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Sockets opened per client address, counted in each Cloudflare location (see the Worker): making or probing a room wakes objects, which bill for requests, writes and an alarm.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
